DATABASE_URL=sqlite:///./tickets.db

# Gere uma chave com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=troque-esta-chave-antes-de-ir-para-producao
ACCESS_TOKEN_EXPIRE_MINUTES=60

# keywords: classificador por palavras-chave (padrão, não precisa de chave)
# anthropic: usa o Claude e cai para as palavras-chave se a API falhar
TRIAGE_PROVIDER=keywords
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
TRIAGE_TIMEOUT_SECONDS=20
